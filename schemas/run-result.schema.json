{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fallbackcontract:schema:run-result:v1",
  "title": "LLM Fallback Compatibility Tester Run Result v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "contract",
    "tool_version",
    "config_digest",
    "started_at_unix_ms",
    "environment",
    "scenarios"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "format": "uuid" },
    "contract": { "type": "string" },
    "tool_version": { "type": "string" },
    "config_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "started_at_unix_ms": { "type": "integer", "minimum": 0 },
    "environment": { "type": "string" },
    "scenarios": { "type": "array", "items": { "$ref": "#/$defs/scenario" } }
  },
  "additionalProperties": false,
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "description",
        "verdict",
        "attempts",
        "cases",
        "events"
      ],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "verdict": { "enum": ["passed", "failed", "inconclusive"] },
        "attempts": { "type": "array", "items": { "type": "object" } },
        "cases": { "type": "array", "items": { "type": "object" } },
        "events": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    }
  }
}
